# Supabase project settings -> API. The anon key is public; never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: restrict the Google account picker to the district's domain, e.g. district.org
VITE_GOOGLE_HOSTED_DOMAIN=
