{
  "manifest_version": 3,
  "name": "Send to Oasis",
  "short_name": "Oasis",
  "version": "0.1.0",
  "description": "Send the YouTube video you're watching, with its transcript, to the Oasis lesson builder.",
  "action": {
    "default_title": "Send this video to Oasis",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab", "scripting"],
  "minimum_chrome_version": "102"
}
